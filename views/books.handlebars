<h2>Danh sách sách</h2>

<a class="btn" href="/books/add">
  + Thêm sách mới
</a>

<table>
  <thead>
    <tr>
      <th>Mã sách</th>
      <th>Tên sách</th>
      <th>Tác giả</th>
      <th>Giá gốc</th>
      <th>VAT</th>
      <th>Giá sau thuế</th>
    </tr>
  </thead>

  <tbody>

    {{#each books}}

      <tr>
        <td>{{productCode}}</td>
        <td>{{title}}</td>
        <td>{{author}}</td>
        <td>{{price}}</td>
        <td>{{vat}}%</td>
        <td>{{priceAfterTax}}</td>
      </tr>

    {{else}}

      <tr>
        <td colspan="6">
          Chưa có sách.
        </td>
      </tr>

    {{/each}}

  </tbody>
</table>